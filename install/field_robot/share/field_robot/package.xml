<?xml version="1.0"?>
<package format="3">
  <name>field_robot</name>
  <version>0.1.0</version>
  <description>Field robot: 8-node distributed system (map / control / motor / fusion / mpu / spray / trigger / web)</description>
  <maintainer email="wang@example.com">Wang</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
